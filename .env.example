# ============================================================================
# CPET Environment Configuration Example
# ============================================================================
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
MONGODB_URI=mongodb://localhost:27017/cpet

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Authentication & Session Secrets (Must be at least 32 characters in production)
JWT_SECRET=replace-with-a-secure-secret-at-least-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-secure-secret-at-least-32-chars-long
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-secure-secret-at-least-32-chars-long

# Logging
LOG_LEVEL=info

# SMTP Email Configuration for Real OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=noreply@cpet.org
SMTP_FROM_NAME=CPET

